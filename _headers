# Cloudflare Pages headers — Google OAuth and fresh app assets
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://accounts.google.com; script-src 'self' https://cdn.jsdelivr.net https://accounts.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://www.googleapis.com https://cloudflareinsights.com; frame-src https://accounts.google.com https://www.tiktok.com https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site

/
  Cache-Control: no-store, no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/app.js
  Cache-Control: no-cache, must-revalidate

/styles.css
  Cache-Control: no-cache, must-revalidate

/js/db.js
  Cache-Control: no-cache, must-revalidate

/styles/signal-feed-window.css
  Cache-Control: no-cache, must-revalidate

/js/signal-feed-window.js
  Cache-Control: no-cache, must-revalidate


/terms
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/terms.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/privacy
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/privacy.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
